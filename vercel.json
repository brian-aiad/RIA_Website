{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/SITEMAP.XML",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/locations/",
      "destination": "/locations",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/accessibility/",
      "destination": "/accessibility",
      "permanent": true
    },
    {
      "source": "/auto-insurance-los-angeles-ca/",
      "destination": "/auto-insurance-los-angeles-ca",
      "permanent": true
    },
    {
      "source": "/sr22-insurance-los-angeles/",
      "destination": "/sr22-insurance-los-angeles",
      "permanent": true
    },
    {
      "source": "/no-license-auto-insurance-los-angeles/",
      "destination": "/no-license-auto-insurance-los-angeles",
      "permanent": true
    },
    {
      "source": "/commercial-auto-insurance-los-angeles/",
      "destination": "/commercial-auto-insurance-los-angeles",
      "permanent": true
    },
    {
      "source": "/home-insurance-los-angeles-ca/",
      "destination": "/home-insurance-los-angeles-ca",
      "permanent": true
    },
    {
      "source": "/insurance/mar-vista/",
      "destination": "/insurance/mar-vista",
      "permanent": true
    },
    {
      "source": "/insurance/culver-city/",
      "destination": "/insurance/culver-city",
      "permanent": true
    },
    {
      "source": "/insurance/santa-monica/",
      "destination": "/insurance/santa-monica",
      "permanent": true
    },
    {
      "source": "/insurance/venice/",
      "destination": "/insurance/venice",
      "permanent": true
    },
    {
      "source": "/insurance/marina-del-rey/",
      "destination": "/insurance/marina-del-rey",
      "permanent": true
    },
    {
      "source": "/insurance/west-los-angeles/",
      "destination": "/insurance/west-los-angeles",
      "permanent": true
    },
    {
      "source": "/insurance/playa-vista/",
      "destination": "/insurance/playa-vista",
      "permanent": true
    },
    {
      "source": "/insurance/westchester/",
      "destination": "/insurance/westchester",
      "permanent": true
    },
    {
      "source": "/insurance/inglewood/",
      "destination": "/insurance/inglewood",
      "permanent": true
    },
    {
      "source": "/insurance/beverly-hills/",
      "destination": "/insurance/beverly-hills",
      "permanent": true
    },
    {
      "source": "/insurance/el-segundo/",
      "destination": "/insurance/el-segundo",
      "permanent": true
    },
    {
      "source": "/insurance/manhattan-beach/",
      "destination": "/insurance/manhattan-beach",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/cdn-cgi/l/email-protection", "destination": "/api/gone" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "query", "key": "q" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "</images/ois-hero-consultation-2026.webp>; rel=preload; as=image; type=image/webp; fetchpriority=high" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), payment=(), usb=(), bluetooth=(), serial=(), geolocation=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com https://vitals.vercel-insights.com; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com;" }
      ]
    }
  ]
}
