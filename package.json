{
  "name": "rafla-insurance-agency",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "validate:schema": "node scripts/validate-schema.mjs",
    "seo-lint": "node scripts/seo-lint.mjs",
    "qa:routes": "node scripts/qa-routes.mjs",
    "qa:interactions": "node scripts/qa-interactions.mjs",
    "qa:text": "node scripts/qa-text-collisions.mjs",
    "qa:a11y": "node scripts/qa-a11y.mjs",
    "qa:structure": "node scripts/qa-structure.mjs",
    "qa:production": "node scripts/qa-production.mjs",
    "qa:performance": "node scripts/qa-performance.mjs",
    "qa:motion": "node scripts/qa-motion.mjs",
    "deploy:check": "npm run build && node scripts/check-deployment.mjs",
    "qa:imagery": "node scripts/qa-imagery.mjs",
    "qa:interaction-states": "node scripts/qa-interaction-states.mjs",
    "qa:reading-tools": "node scripts/qa-reading-tools.mjs",
    "qa:scroll-scenes": "node scripts/qa-scroll-scenes.mjs",
    "test:quote-api": "node --experimental-strip-types --test scripts/test-quote-api.mjs",
    "qa:quote-form": "node scripts/qa-quote-form.mjs",
    "build:review": "node scripts/build.mjs --review",
    "preview:review": "vite preview --outDir dist-review",
    "qa:gate": "node scripts/qa-release-gate.mjs && node --experimental-strip-types scripts/test-release-gate-api.mjs",
    "validate:schema:review": "QA_DIST_DIR=dist-review node scripts/validate-schema.mjs",
    "qa:production:review": "QA_DIST_DIR=dist-review node scripts/qa-production.mjs",
    "review:check": "npm run seo-lint && npm run build:review && npm run validate:schema:review && npm run qa:production:review",
    "qa:motion-lifecycle": "node scripts/qa-motion-lifecycle.mjs",
    "qa:gate:browser": "node scripts/qa-gate-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "@vercel/speed-insights": "^2.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.548.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "playwright": "^1.50.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
